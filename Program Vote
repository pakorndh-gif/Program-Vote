function resultsCSV(room, people){
  const L=[];
  L.push(['ห้อง',room.title].join(','));
  L.push(['รหัสห้อง',room.code].join(','));
  L.push(['ออกรายงานเมื่อ',U.dt(Date.now())].join(','));
  L.push(['จำนวนผู้เข้าร่วม',people.length].join(','));
  L.push('');
  const esc = s=>'"'+String(s==null?'':s).replace(/"/g,'""')+'"';
  if(room.collectNames && room.display!=='anon'){
    L.push(esc('บัญชีรายชื่อผู้เข้าร่วม'));
    L.push(['ลำดับ','ชื่อ-นามสกุล','ชื่อเล่น','รหัส','กลุ่ม','ตอบแล้ว (ข้อ)','เวลาเข้าร่วม'].map(esc).join(','));
    people.forEach((p,i)=> L.push([i+1,p.name||'',p.nickname||'',p.studentId||'',p.group||'',
      Object.keys(p.answers||{}).length, U.dt(p.joinedAt)].map(esc).join(',')) );
    L.push('');
  }
  (room.questions||[]).forEach((q,i)=>{
    const t = tally(q,people);
    L.push([esc('คำถามที่ '+(i+1)), esc(q.text), esc(QTYPES[q.type].label)].join(','));
    if(q.type==='text'){
      L.push(['ลำดับ','ชื่อ','ชื่อเล่น','รหัส','กลุ่ม','ข้อความ'].map(esc).join(','));
      const anon = room.display==='anon';
      (t.texts||[]).forEach((x,j)=> L.push([j+1, anon?'(ไม่ระบุ)':(x.name||''), anon?'':(x.nickname||''), anon?'':(x.studentId||''), x.group||'', x.text].map(esc).join(',')) );
    } else {
      L.push(['ตัวเลือก','จำนวน','ร้อยละ'].map(esc).join(','));
      t.rows.slice().sort((a,b)=> q.type==='scale'? a.idx-b.idx : b.value-a.value)
        .forEach(r=> L.push([ r.label+(r.sub?(' — '+r.sub):''), r.value, U.pct(r.value,t.total)+'%' ].map(esc).join(',')) );
      L.push([esc('รวมผู้ตอบ'), t.n, ''].join(','));
      if(q.type==='scale') L.push([esc('ค่าเฉลี่ย'), (t.avg||0).toFixed(2), esc('SD '+(t.sd||0).toFixed(2))].join(','));
    }
    L.push('');
  });
  return '﻿'+L.join('\r\n');   // BOM เพื่อให้ Excel อ่านภาษาไทยถูกต้อง
}
function resultsText(room, people){
  const L=[`สรุปผลการโหวต — ${room.title}  (รหัสห้อง ${room.code})`,`ผู้เข้าร่วม ${people.length} คน · ${U.dt(Date.now())}`,''];
  (room.questions||[]).forEach((q,i)=>{
    const t=tally(q,people);
    L.push(`${i+1}. ${q.text}  [${QTYPES[q.type].label}] — ผู้ตอบ ${t.n} คน`);
    if(q.type==='text') (t.texts||[]).forEach((x,j)=> L.push(`   ${j+1}) ${x.text}${room.display==='anon'?'':(' — '+(x.name||'ไม่ระบุ'))}`) );
    else {
      t.rows.slice().sort((a,b)=> q.type==='scale'? a.idx-b.idx : b.value-a.value)
        .forEach(r=> L.push(`   • ${r.label}${r.sub?(' ('+r.sub+')'):''} : ${U.n(r.value)} (${U.pct(r.value,t.total)}%)`) );
      if(q.type==='scale') L.push(`   ค่าเฉลี่ย ${(t.avg||0).toFixed(2)} · SD ${(t.sd||0).toFixed(2)}`);
    }
    L.push('');
  });
  return L.join('\n');
}
/* ส่งออกกราฟเป็น PNG — ฝังสีที่คำนวณแล้ว เพราะ CSS variable ไม่ติดไปกับไฟล์ */
async function exportPNG(hostEl, filename){
  const src = hostEl.querySelector('svg');
  if(!src){ Toast.show('กราฟนี้ยังส่งออกเป็นรูปไม่ได้'); return; }
  const clone = src.cloneNode(true);
  const srcNodes = src.querySelectorAll('*'), clNodes = clone.querySelectorAll('*');
  for(let i=0;i<srcNodes.length;i++){
    const cs = getComputedStyle(srcNodes[i]), c = clNodes[i];
    ['fill','stroke','stroke-width','font-size','font-weight','opacity'].forEach(p=>{
      const v = cs.getPropertyValue(p); if(v) c.setAttribute(p, v);
    });
    c.setAttribute('font-family', "'Noto Sans Thai','Sarabun',sans-serif");
    c.removeAttribute('class'); c.removeAttribute('style');
  }
  const vb = (src.getAttribute('viewBox')||'0 0 1000 400').split(/\s+/).map(Number);
  const W = vb[2]||1000, H = vb[3]||400, S = 2;
  clone.setAttribute('width', W); clone.setAttribute('height', H);
  clone.setAttribute('xmlns', SVGNS);
  const bg = getComputedStyle(document.body).getPropertyValue('--surface').trim() || '#ffffff';
  const xml = new XMLSerializer().serializeToString(clone);
  const url = 'data:image/svg+xml;charset=utf-8,'+encodeURIComponent(`<svg xmlns="${SVGNS}" width="${W}" height="${H}" viewBox="0 0 ${W} ${H}"><rect width="100%" height="100%" fill="${bg}"/>${xml.replace(/^<svg[^>]*>/,'').replace(/<\/svg>$/,'')}</svg>`);
  try{
    const img = new Image();
    await new Promise((res,rej)=>{ img.onload=res; img.onerror=()=>rej(new Error('render')); img.src=url; });
    const cv = document.createElement('canvas'); cv.width=W*S; cv.height=H*S;
    const ctx = cv.getContext('2d'); ctx.scale(S,S);
    ctx.fillStyle = bg; ctx.fillRect(0,0,W,H);
    ctx.drawImage(img,0,0,W,H);
    const blob = await new Promise(r=>cv.toBlob(r,'image/png'));
    await saveFile(filename, blob, 'image/png');
  }catch(e){ Toast.show('สร้างไฟล์รูปไม่สำเร็จ — ลองใช้การจับภาพหน้าจอจากโหมดจอฉาย'); }
}

