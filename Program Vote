document.addEventListener('keydown', async e=>{
  if(App.route!=='screen' || !App.room) return;
  if(e.target && /INPUT|TEXTAREA|SELECT/.test(e.target.tagName)) return;
  const r = App.room, qs = r.questions||[];
  const i = qs.findIndex(x=>x.id===r.currentQ);
  if(e.key==='ArrowRight' && i < qs.length-1){ r.currentQ=qs[i+1].id; e.preventDefault(); await App.saveMeta(); }
  else if(e.key==='ArrowLeft' && i>0){ r.currentQ=qs[i-1].id; e.preventDefault(); await App.saveMeta(); }
  else if(e.code==='Space'){ const q=App.currentQ(); if(q){ q.revealed=!q.revealed; q.revealAt=null; e.preventDefault(); await App.saveMeta(); } }
  else if(e.key==='f'||e.key==='F'){ try{ document.fullscreenElement? document.exitFullscreen() : document.documentElement.requestFullscreen(); }catch(err){} }
});

