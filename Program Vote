const Modal = {
  open(title, bodyEl, actions){
    Modal.close();
    const card = U.h('div',{class:'card modal'});
    card.appendChild(U.h('div',{class:'row',style:{'margin-bottom':'16px'}},[
      U.h('h3',{class:'grow',style:{'font-size':'20px'},text:title}),
      U.h('button',{class:'btn btn-icon btn-ghost','aria-label':'ปิด',text:'✕',onclick:Modal.close})
    ]));
    card.appendChild(bodyEl);
    if(actions && actions.length){
      const row = U.h('div',{class:'row',style:{'margin-top':'22px','justify-content':'flex-end'}});
      actions.forEach(a=> row.appendChild(U.h('button',{class:'btn '+(a.kind||''),text:a.label,onclick:a.onClick})));
      card.appendChild(row);
    }
    const back = U.h('div',{class:'modal-back',onclick:e=>{ if(e.target===back) Modal.close(); }},card);
    $('#modalRoot').appendChild(back);
    const f = card.querySelector('input,select,textarea'); if(f) setTimeout(()=>f.focus(),80);
  },
  close(){ $('#modalRoot').innerHTML=''; },
  confirm(title, msg, onYes, yesLabel, kind){
    Modal.open(title, U.h('p',{class:'sec',text:msg}), [
      { label:'ยกเลิก', onClick:Modal.close },
      { label:yesLabel||'ยืนยัน', kind:kind||'btn-danger', onClick:()=>{ Modal.close(); onYes(); } }
    ]);
  }
};
