    const foot = U.h('div',{class:'row',style:{gap:'8px'}});
    foot.appendChild(U.h('div',{class:'by grow',text: named ? displayName(x) + (x.group? ' · '+x.group:'') : 'ไม่ระบุชื่อผู้ส่ง'}));
