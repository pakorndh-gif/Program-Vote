  }
  const info = U.h('div',{class:'grow col',style:{gap:'9px'}});
  info.appendChild(U.h('h4',{style:{'font-size':'15px'},text:'ให้ผู้เข้าร่วมเข้าห้อง'}));
  info.appendChild(U.h('div',{class:'row row-wrap',style:{gap:'10px'}},[
    U.h('span',{class:'code-badge',style:{'font-size':'21px'},text:room.code}),
    U.h('span',{class:'chip',text: online?'ออนไลน์ · มือถือเครื่องใดก็ได้':'เฉพาะเครื่องนี้'})
  ]));
