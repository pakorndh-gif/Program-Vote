/* ---------- กล่องเข้าร่วม / เปิดจอฉาย ---------- */
function dlgJoin(target){
  const body = U.h('div',{class:'col'});
  const inp = U.h('input',{class:'input',inputmode:'numeric',maxlength:'6',placeholder:'000000',
    style:{'font-size':'30px','letter-spacing':'.3em','text-align':'center','font-weight':'800'}});
  body.appendChild(U.h('div',{class:'field'},[ U.h('label',{text:'รหัสห้อง 6 หลัก'}), inp ]));
  const cloudOk = Cloud.ready;
  const where = U.h('select',{class:'input'},[
    U.h('option',{value:'auto',text:'ค้นหาอัตโนมัติ (แนะนำ)'}),
    U.h('option',{value:'online',text:'ห้องเรียนออนไลน์'}),
    U.h('option',{value:'local',text:'ห้องที่สร้างในเครื่องนี้'}),
    U.h('option',{value:'cloud',text:'ห้องผ่านบัญชีองค์กร'+(cloudOk?'':' (ใช้ไม่ได้)'),disabled:!cloudOk})
  ]);
  body.appendChild(U.h('div',{class:'field'},[ U.h('label',{text:'ค้นหาห้องจาก'}), where ]));
  const go = async()=>{
    const code = inp.value.replace(/\D/g,'');
    if(code.length!==6){ Toast.show('กรุณาใส่รหัส 6 หลัก'); return; }
    const order = where.value==='auto' ? ['online','local','cloud'] : [where.value];
    for(const s of order){
      if(s==='online' && !Online.host(null)) continue;
      if(s==='cloud' && !Cloud.ready) continue;
      if(await App.openRoom(code, s)){ Modal.close(); App.nav(target); return; }
    }
    Toast.show('ไม่พบห้องรหัส '+code);
  };
  inp.addEventListener('keydown', e=>{ if(e.key==='Enter') go(); });
  Modal.open(target==='vote'?'เข้าร่วมโหวต':'เปิดจอฉาย', body, [
    { label:'ยกเลิก', onClick:Modal.close },
    { label:'เข้าห้อง', kind:'btn-primary', onClick:go }
  ]);
}
/* ============================================================
   12) การส่งออกไฟล์
   (ในหน้านี้การดาวน์โหลดปกติถูกบล็อก จึงใช้ความสามารถ downloads
    และมีปุ่มคัดลอกเป็นทางสำรองเสมอ)
   ============================================================ */
async function saveFile(filename, data, mime){
  try{
    if(window.claude && window.claude.use){
      const d = await window.claude.use('downloads');
      if(d){ await d.save({ filename, data }); Toast.show('บันทึกไฟล์ '+filename+' แล้ว'); return true; }
    }
  }catch(e){ /* ผู้ใช้ปฏิเสธ หรือใช้ไม่ได้ */ }
  try{
    const blob = (data instanceof Blob) ? data : new Blob([data],{type:mime||'text/plain;charset=utf-8'});
    const a = document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=filename;
    document.body.appendChild(a); a.click(); setTimeout(()=>{ URL.revokeObjectURL(a.href); a.remove(); },500);
    Toast.show('ดาวน์โหลด '+filename+' แล้ว'); return true;
  }catch(e){ Toast.show('หน้านี้ดาวน์โหลดไฟล์ไม่ได้ — ใช้ปุ่ม “คัดลอกผล” แทน'); return false; }
}
