/* ---------- ส่วนลงคะแนนตามชนิดคำถาม ---------- */
function voteUI(q, r, me){
  const box = U.h('div',{class:'col'});
  const locked = q.status!=='open';
  const cur = me.answers? me.answers[q.id] : undefined;
  const send = async val=>{
    // กันการส่งคำตอบจากหน้าจอที่ค้างอยู่หลังผู้ดำเนินการปิดโหวตไปแล้ว
    if(q.status!=='open'){ Toast.show('คำถามนี้ปิดรับคำตอบแล้ว'); return; }
    me.answers = me.answers||{}; me.answers[q.id]=val;
    const ok = await Net.savePerson(r, me);
    if(ok){ await App.refresh(); }
  };

  if(q.type==='single' || q.type==='yesno'){
    const opts = optsOf(q);
    const g = U.h('div',{class:'vote-opts'});
    opts.forEach((o,i)=>{
      g.appendChild(U.h('button',{class:'opt-btn'+(cur===o.id?' picked':''),disabled:locked?'':null,
        style:{'--c':optColor(q,i)},onclick:()=>send(o.id)},[
        U.h('span',{class:'key',text:String.fromCharCode(65+i)}),
        U.h('span',{class:'lbl',text:o.label}),
        U.h('span',{class:'tick',text:'✓'})
      ]));
    });
    box.appendChild(g);
  }
  else if(q.type==='multi'){
    const opts = optsOf(q), sel = new Set(Array.isArray(cur)?cur:[]);
    const max = q.maxSelect||2;
    box.appendChild(U.h('p',{class:'hint',text:`เลือกได้ไม่เกิน ${max} ข้อ (เลือกแล้ว ${sel.size} ข้อ)`}));
    const g = U.h('div',{class:'vote-opts'});
    opts.forEach((o,i)=>{
      g.appendChild(U.h('button',{class:'opt-btn'+(sel.has(o.id)?' picked':''),disabled:locked?'':null,
        style:{'--c':optColor(q,i)},onclick:()=>{
          if(sel.has(o.id)) sel.delete(o.id);
          else { if(sel.size>=max){ Toast.show(`เลือกได้ไม่เกิน ${max} ข้อ`); return; } sel.add(o.id); }
          send(Array.from(sel));
        }},[
        U.h('span',{class:'key',text: sel.has(o.id)?'✓':String.fromCharCode(65+i)}),
        U.h('span',{class:'lbl',text:o.label}),
        U.h('span',{class:'tick',text:'✓'})
      ]));
    });
    box.appendChild(g);
  }
  else if(q.type==='scale'){
    const row = U.h('div',{class:'scale-row'});
    for(let s=q.scaleMin;s<=q.scaleMax;s++){
      const lab = (q.scaleLabels||[])[s-q.scaleMin]||'';
      row.appendChild(U.h('button',{class:'scale-btn'+(Number(cur)===s?' picked':''),disabled:locked?'':null,
        onclick:()=>send(s)},[ document.createTextNode(String(s)), lab? U.h('small',{text:lab}) : null ]));
    }
    box.appendChild(row);
    const a=(q.scaleLabels||[])[0], b=(q.scaleLabels||[])[q.scaleMax-q.scaleMin];
    if(a||b) box.appendChild(U.h('div',{class:'row'},[
      U.h('span',{class:'hint grow',text:a||''}), U.h('span',{class:'hint',style:{'text-align':'right'},text:b||''})
    ]));
  }
  else if(q.type==='rank'){
    const opts = optsOf(q);
    const order = (Array.isArray(cur)&&cur.length===opts.length) ? cur.slice() : opts.map(o=>o.id);
    const list = U.h('div',{});
    order.forEach((id,i)=>{
      const o = opts.find(x=>x.id===id) || {label:'?'};
      const it = U.h('div',{class:'rank-item'});
      it.appendChild(U.h('span',{class:'pos',text:String(i+1)}));
      it.appendChild(U.h('span',{class:'grow',text:o.label}));
      it.appendChild(U.h('button',{class:'btn btn-sm btn-ghost',text:'↑',disabled:(locked||i===0)?'':null,
        onclick:()=>{ [order[i-1],order[i]]=[order[i],order[i-1]]; send(order.slice()); }}));
      it.appendChild(U.h('button',{class:'btn btn-sm btn-ghost',text:'↓',disabled:(locked||i===order.length-1)?'':null,
        onclick:()=>{ [order[i+1],order[i]]=[order[i],order[i+1]]; send(order.slice()); }}));
      list.appendChild(it);
    });
    box.appendChild(U.h('p',{class:'hint',text:'เรียงจากสำคัญที่สุด (บน) ไปน้อยที่สุด (ล่าง) ด้วยปุ่มลูกศร'}));
    box.appendChild(list);
    if(!Array.isArray(cur)) box.appendChild(U.h('button',{class:'btn btn-primary',disabled:locked?'':null,
      text:'ส่งลำดับนี้',onclick:()=>send(order.slice())}));
  }
  else if(q.type==='text'){
    const ta = U.h('textarea',{class:'input',rows:4,placeholder:'พิมพ์ความเห็นของคุณ',value:cur||'',disabled:locked?'':null});
    box.appendChild(ta);
    box.appendChild(U.h('div',{class:'row'},[
      U.h('span',{class:'hint grow',text:'ข้อความจะไปปรากฏบนจอฉายเป็นการ์ดความเห็น'}),
      U.h('button',{class:'btn btn-primary',disabled:locked?'':null,text: cur?'แก้ไขคำตอบ':'ส่งความเห็น',
        onclick:()=>{ const v=ta.value.trim(); if(!v){ Toast.show('ยังไม่ได้พิมพ์ข้อความ'); return; } send(v); }})
    ]));
  }
  return box;
}
