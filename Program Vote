function seededWeights(q){
  // น้ำหนักคงที่ต่อคำถาม เพื่อให้ผลจำลองดูสมจริงและไม่กระโดดไปมา
  let h=0; for(const ch of (q.id||'')) h=(h*31+ch.charCodeAt(0))%9973;
  const n = optsOf(q).length || (q.scaleMax-q.scaleMin+1);
  const w=[]; for(let i=0;i<n;i++){ h=(h*1103515245+12345)%2147483647; w.push(0.6+ (h%1000)/1000*2.4); }
  return w;
}
function pickWeighted(w){
  const s = w.reduce((a,b)=>a+b,0); let x = Math.random()*s;
  for(let i=0;i<w.length;i++){ x-=w[i]; if(x<=0) return i; }
  return w.length-1;
}
async function simulate(n){
  const r = App.room; if(!r) return;
  Toast.show('กำลังสร้างผู้โหวตจำลอง '+n+' คน…');
  const groups = (r.groups||[]);
  const existing = App.people.filter(p=>p.sim).length;
  for(let i=0;i<n;i++){
    const idx = existing+i;
    const pid = 'sim'+String(idx).padStart(4,'0');
    const F = r.fields || (r.collectNames? {name:true} : {});
    const p = {
      pid, code:r.code, sim:true, joinedAt: Date.now()+i,
      name: F.name ? THAI_NAMES[idx % THAI_NAMES.length] + (idx>=THAI_NAMES.length? ' '+(Math.floor(idx/THAI_NAMES.length)+1):'') : '',
      nickname: F.nickname ? NICKS[idx % NICKS.length] + (idx>=NICKS.length? String(Math.floor(idx/NICKS.length)+1):'') : '',
      studentId: F.studentId ? String(66010000 + idx + 1) : '',
      group: groups.length? groups[idx % groups.length] : '',
      answers:{}
    };
    (r.questions||[]).forEach(q=>{
      const opts = optsOf(q);
      const w = seededWeights(q);
      if(q.type==='single'||q.type==='yesno') p.answers[q.id]=opts[pickWeighted(w)].id;
      else if(q.type==='multi'){
        const k = 1+Math.floor(Math.random()*Math.min(q.maxSelect||2,opts.length));
        const set=new Set(); while(set.size<k) set.add(opts[pickWeighted(w)].id);
        p.answers[q.id]=Array.from(set);
      }
      else if(q.type==='scale'){ p.answers[q.id]=q.scaleMin+pickWeighted(w); }
      else if(q.type==='rank'){
        const a = opts.map(o=>o.id);
        for(let j=a.length-1;j>0;j--){ const k2=Math.floor(Math.random()*(j+1)); [a[j],a[k2]]=[a[k2],a[j]]; }
        p.answers[q.id]=a;
      }
      else if(q.type==='text'){ if(Math.random()<0.65) p.answers[q.id]=SIM_TEXTS[Math.floor(Math.random()*SIM_TEXTS.length)]; }
    });
    if(Net.isCloud(r)){
      try{ await Cloud.db.doc('votes/'+pid).set(p); }catch(e){ Toast.show('โหมดข้ามเครื่องไม่อนุญาตให้สร้างผู้โหวตจำลอง'); break; }
    } else Store.setPerson(r.code, p);
  }
  await App.refresh();
  Toast.show('สร้างผู้โหวตจำลองแล้ว');
}
