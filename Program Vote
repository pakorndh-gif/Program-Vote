      onclick:()=>{ const hs=new Set(q.hiddenAnswers||[]); hs.has(x.pid)?hs.delete(x.pid):hs.add(x.pid);
        q.hiddenAnswers=Array.from(hs); App.saveMeta(); }}));
    n.appendChild(foot);
    g.appendChild(n);
  });
  return g;
}

