<!DOCTYPE html>
<html lang="th" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>ระบบโหวตและแสดงผลสด (Live Vote)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700;800&family=IBM+Plex+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ============================================================
   ระบบโหวตและแสดงผลสด — Design tokens
   โทนกรมท่า-ทอง (brand = chrome)  +  จานสีข้อมูลที่ผ่านการตรวจ
   CVD / contrast แล้ว (brand ไม่ถูกใช้เป็นสีของข้อมูล)
   ============================================================ */
:root{
  --font: 'Sarabun','IBM Plex Sans Thai','Noto Sans Thai',system-ui,-apple-system,'Segoe UI',sans-serif;

  --r-sm: 8px; --r-md: 12px; --r-lg: 18px; --r-xl: 26px;
  --sp-1: 4px; --sp-2: 8px; --sp-3: 12px; --sp-4: 16px; --sp-5: 24px; --sp-6: 32px; --sp-7: 48px;

  --ease: cubic-bezier(.22,.61,.36,1);
  --dur: 420ms;

  /* ---- สถานะ (fixed, ไม่เปลี่ยนตามธีม) ---- */
  --st-good:#0ca30c; --st-warn:#fab219; --st-serious:#ec835a; --st-crit:#d03b3b;
}

/* ---------- โหมดกรมท่า (ค่าเริ่มต้น สำหรับห้องประชุม/จอฉาย) ---------- */
:root[data-theme="dark"]{
  color-scheme: dark;
  --plane:#081525;
  --plane-2:#0a1a2c;
  --surface:#0f1f36;
  --surface-2:#0f1f36;      /* chart surface (ตรงกับที่ validate) */
  --surface-hi:#15294390;
  --ink:#f0efec;
  --ink-2:#c3c2b7;
  --ink-muted:#8d9bb0;
  --grid:#1b3252;
  --axis:#27405f;
  --border:rgba(255,255,255,.10);
  --border-2:rgba(255,255,255,.055);
  --brand:#16304f;
  --brand-hi:#1d3c61;
  --gold:#d9b64a;
  --gold-ink:#e3c66a;
  --gold-dim:#d9b64a33;
  --shadow: 0 10px 34px rgba(0,0,0,.42);
  --fill-ink:#ffffff;        /* ตัวอักษรบนพื้นสีข้อมูล */

  --s1:#3987e5; --s2:#d95926; --s3:#199e70; --s4:#c98500;
  --s5:#d55181; --s6:#0ca30c; --s7:#9085e9; --s8:#e66767;

  /* ordinal ramp (น้ำเงินเดี่ยว) เข้ม→อ่อน ตามหลักโหมดมืด */
  --o1:#184f95; --o2:#256abf; --o3:#3987e5; --o4:#6da7ec; --o5:#9ec5f4;
  /* sequential ramp สำหรับ heatmap (ค่าน้อย→มาก) */
  --q0:#0f1f36; --q1:#14365e; --q2:#184f95; --q3:#256abf; --q4:#3987e5; --q5:#6da7ec; --q6:#9ec5f4;
}

/* ---------- โหมดสว่าง (เอกสาร/พิมพ์/ห้องสว่างมาก) ---------- */
:root[data-theme="light"]{
  color-scheme: light;
  --plane:#f2f3ef;
  --plane-2:#e9eae5;
  --surface:#ffffff;
  --surface-2:#fbfbf9;      /* chart surface (ตรงกับที่ validate) */
  --surface-hi:#f4f5f1;
  --ink:#0b0b0b;
  --ink-2:#52514e;
  --ink-muted:#898781;
  --grid:#e1e0d9;
  --axis:#c3c2b7;
  --border:rgba(11,11,11,.10);
  --border-2:rgba(11,11,11,.06);
  --brand:#0f2b4c;
  --brand-hi:#15385f;
  --gold:#b8901f;
  --gold-ink:#7a5c0a;
  --gold-dim:#b8901f2b;
  --shadow: 0 8px 26px rgba(11,11,11,.10);
  --fill-ink:#ffffff;

  --s1:#2a78d6; --s2:#eb6834; --s3:#1baf7a; --s4:#eda100;
  --s5:#e87ba4; --s6:#008300; --s7:#6250d6; --s8:#e34948;

  --o1:#86b6ef; --o2:#5598e7; --o3:#2a78d6; --o4:#1c5cab; --o5:#104281;
  --q0:#fbfbf9; --q1:#cde2fb; --q2:#9ec5f4; --q3:#6da7ec; --q4:#3987e5; --q5:#256abf; --q6:#104281;
}

/* ตัวอักษรบนพื้นสีเหลือง/ทอง ต้องเป็นสีเข้ม (ตามกฎ label-in-fill) */
.fill-dark{ color:#0b0b0b !important; }

*,*::before,*::after{ box-sizing:border-box; }
html,body{ height:100%; }
body{
  margin:0; font-family:var(--font); background:var(--plane); color:var(--ink);
  -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
  font-size:16px; line-height:1.55;
}
:root[data-theme="dark"] body{
  background:
    radial-gradient(1100px 620px at 12% -8%, #12305428 0, transparent 62%),
    radial-gradient(900px 520px at 92% 4%, #d9b64a12 0, transparent 60%),
    var(--plane);
}
h1,h2,h3,h4{ margin:0; font-weight:700; letter-spacing:-.01em; line-height:1.25; }
p{ margin:0; }
button{ font-family:inherit; font-size:inherit; }
input,select,textarea{ font-family:inherit; font-size:inherit; color:inherit; }
a{ color:var(--gold-ink); }
::selection{ background:var(--gold-dim); }
:focus-visible{ outline:2px solid var(--gold); outline-offset:2px; border-radius:6px; }

/* ===================== ชิ้นส่วน UI ===================== */
.btn{
  display:inline-flex; align-items:center; justify-content:center; gap:var(--sp-2);
  padding:10px 16px; min-height:42px; border-radius:var(--r-md);
  border:1px solid var(--border); background:var(--surface-hi); color:var(--ink);
  cursor:pointer; font-weight:600; transition:transform 120ms var(--ease), background 160ms, border-color 160ms, opacity 160ms;
  white-space:nowrap; user-select:none;
}
.btn:hover{ background:var(--surface); border-color:var(--gold-dim); }
.btn:active{ transform:translateY(1px) scale(.995); }
.btn[disabled]{ opacity:.4; cursor:not-allowed; }
.btn-primary{ background:linear-gradient(180deg,var(--gold) 0,#c49f33 100%); color:#1a1200; border-color:#00000022; font-weight:700; }
:root[data-theme="light"] .btn-primary{ background:linear-gradient(180deg,#c89f27 0,#a87f12 100%); color:#fff; }
.btn-primary:hover{ filter:brightness(1.06); background:linear-gradient(180deg,var(--gold) 0,#c49f33 100%); }
.btn-nav{ background:var(--brand); border-color:var(--border); }
.btn-danger{ color:#fff; background:var(--st-crit); border-color:#00000022; }
.btn-danger:hover{ background:#b93232; }
.btn-ghost{ background:transparent; }
.btn-sm{ min-height:34px; padding:6px 11px; font-size:14px; border-radius:var(--r-sm); }
.btn-lg{ min-height:54px; padding:14px 24px; font-size:18px; border-radius:var(--r-lg); }
.btn-icon{ padding:8px; min-height:36px; min-width:36px; }
.btn.on{ background:var(--gold-dim); border-color:var(--gold); color:var(--gold-ink); }

.card{
  background:var(--surface); border:1px solid var(--border-2); border-radius:var(--r-lg);
  padding:var(--sp-5); box-shadow:var(--shadow);
}
.card-tight{ padding:var(--sp-4); }

.chip{
  display:inline-flex; align-items:center; gap:6px; padding:4px 10px; border-radius:999px;
  background:var(--surface-hi); border:1px solid var(--border-2); font-size:13px; color:var(--ink-2); font-weight:600;
}
.chip-live{ color:var(--st-good); border-color:#0ca30c44; background:#0ca30c14; }
.chip-gold{ color:var(--gold-ink); border-color:var(--gold-dim); background:var(--gold-dim); }
.dot{ width:8px; height:8px; border-radius:50%; background:currentColor; flex:none; }
.dot-pulse{ animation:pulse 1.8s var(--ease) infinite; }
@keyframes pulse{ 0%,100%{opacity:1; transform:scale(1);} 50%{opacity:.35; transform:scale(.8);} }

.field{ display:flex; flex-direction:column; gap:6px; }
.field > label{ font-size:13px; font-weight:600; color:var(--ink-2); }
.input, select.input, textarea.input{
  width:100%; padding:11px 13px; border-radius:var(--r-md);
  border:1px solid var(--border); background:var(--plane-2); color:var(--ink);
  transition:border-color 150ms, background 150ms;
}
:root[data-theme="light"] .input{ background:#fff; }
.input:focus{ border-color:var(--gold); outline:none; background:var(--surface); }
textarea.input{ resize:vertical; min-height:72px; }
.hint{ font-size:12.5px; color:var(--ink-muted); line-height:1.5; }

.row{ display:flex; gap:var(--sp-3); align-items:center; }
.row-wrap{ flex-wrap:wrap; }
.col{ display:flex; flex-direction:column; gap:var(--sp-3); }
.grow{ flex:1 1 auto; min-width:0; }
.spacer{ flex:1 1 auto; }
.hr{ height:1px; background:var(--border-2); border:0; margin:var(--sp-4) 0; }
.sr{ position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; border:0; }
.muted{ color:var(--ink-muted); }
.sec{ color:var(--ink-2); }
.mono{ font-variant-numeric:tabular-nums; }
.hide{ display:none !important; }

/* ===================== แถบบน ===================== */
.topbar{
  position:sticky; top:0; z-index:40; display:flex; align-items:center; gap:var(--sp-3);
  padding:10px max(var(--sp-4), env(safe-area-inset-left)) 10px max(var(--sp-4), env(safe-area-inset-right));
  padding-top:max(10px, env(safe-area-inset-top));
  background:color-mix(in srgb, var(--plane) 88%, transparent);
  backdrop-filter:blur(14px); border-bottom:1px solid var(--border-2); flex-wrap:wrap;
}
.brandmark{ display:flex; align-items:center; gap:10px; font-weight:800; letter-spacing:-.02em; }
.brandmark .seal{
  width:30px; height:30px; border-radius:9px; flex:none;
  background:linear-gradient(145deg,var(--gold) 0,#9a7a17 100%);
  display:grid; place-items:center; color:#17120a; font-size:15px; font-weight:800;
}
.code-badge{
  font-variant-numeric:tabular-nums; letter-spacing:.22em; font-weight:800;
  padding:5px 12px; border-radius:var(--r-sm); background:var(--gold-dim);
  color:var(--gold-ink); border:1px solid var(--gold-dim);
}

/* ===================== หน้าเริ่ม ===================== */
.wrap{ max-width:1180px; margin:0 auto; padding:var(--sp-6) var(--sp-4) var(--sp-7); }
.wrap-narrow{ max-width:720px; }
.hero{ text-align:center; padding:var(--sp-7) 0 var(--sp-6); }
.hero h1{ font-size:clamp(30px,5.2vw,52px); font-weight:800; letter-spacing:-.025em; }
.hero .kicker{ color:var(--gold-ink); font-weight:700; letter-spacing:.16em; font-size:12.5px; text-transform:uppercase; margin-bottom:var(--sp-3); }
.hero p{ color:var(--ink-2); max-width:620px; margin:var(--sp-4) auto 0; font-size:17px; }
.role-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(248px,1fr)); gap:var(--sp-4); }
.role{
  text-align:left; cursor:pointer; border:1px solid var(--border-2); background:var(--surface);
  border-radius:var(--r-xl); padding:var(--sp-5); display:flex; flex-direction:column; gap:10px;
  transition:transform 200ms var(--ease), border-color 200ms, box-shadow 200ms; box-shadow:var(--shadow);
}
.role:hover{ transform:translateY(-3px); border-color:var(--gold-dim); }
.role .ic{ font-size:26px; width:46px; height:46px; border-radius:14px; display:grid; place-items:center; background:var(--gold-dim); }
.role b{ font-size:19px; }
.role span{ color:var(--ink-2); font-size:14.5px; }

/* ===================== Host ===================== */
.host-grid{ display:grid; grid-template-columns:minmax(260px,330px) 1fr; gap:var(--sp-4); align-items:start; }
@media (max-width:980px){ .host-grid{ grid-template-columns:1fr; } }
.qlist{ display:flex; flex-direction:column; gap:7px; max-height:62vh; overflow:auto; padding-right:4px; }
.qitem{
  display:flex; gap:10px; align-items:flex-start; padding:11px 12px; border-radius:var(--r-md);
  border:1px solid var(--border-2); background:var(--plane-2); cursor:pointer; text-align:left;
  transition:border-color 160ms, background 160ms; width:100%;
}
.qitem:hover{ border-color:var(--gold-dim); }
.qitem.sel{ border-color:var(--gold); background:var(--gold-dim); }
.qitem .n{ font-size:12px; font-weight:800; color:var(--ink-muted); min-width:20px; font-variant-numeric:tabular-nums; padding-top:2px; }
.qitem .t{ flex:1; min-width:0; font-size:14.5px; font-weight:600; overflow:hidden; text-overflow:ellipsis; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; }
.qitem .s{ font-size:11px; font-weight:700; padding:2px 7px; border-radius:999px; flex:none; }
.s-draft{ background:var(--border); color:var(--ink-muted); }
.s-open{ background:#0ca30c22; color:var(--st-good); }
.s-closed{ background:#d03b3b22; color:var(--st-crit); }

.optrow{ display:flex; gap:8px; align-items:center; }
.swatch{ width:14px; height:14px; border-radius:4px; flex:none; }

/* ===================== ปุ่มโหวต (ผู้เข้าร่วม) ===================== */
.vote-opts{ display:grid; gap:12px; }
.opt-btn{
  position:relative; display:flex; align-items:center; gap:14px; width:100%;
  padding:18px 18px; border-radius:var(--r-lg); cursor:pointer; text-align:left;
  border:2px solid var(--border); background:var(--surface); color:var(--ink);
  font-size:17px; font-weight:600; min-height:66px; overflow:hidden;
  transition:transform 150ms var(--ease), border-color 160ms, background 160ms;
}
.opt-btn:hover{ transform:translateY(-2px); }
.opt-btn::before{
  content:''; position:absolute; inset:0; background:var(--c); opacity:.10; transition:opacity 180ms;
}
.opt-btn .key{
  width:38px; height:38px; border-radius:11px; flex:none; display:grid; place-items:center;
  background:var(--c); color:#fff; font-weight:800; font-size:17px; z-index:1;
}
.opt-btn .lbl{ z-index:1; flex:1; min-width:0; }
.opt-btn .tick{ z-index:1; opacity:0; font-size:20px; color:var(--c); transition:opacity 180ms; flex:none; }
.opt-btn.picked{ border-color:var(--c); transform:translateY(-2px); }
.opt-btn.picked::before{ opacity:.22; }
.opt-btn.picked .tick{ opacity:1; }
.opt-btn[disabled]{ cursor:not-allowed; opacity:.55; transform:none; }

.scale-row{ display:flex; gap:8px; }
.scale-btn{
  flex:1; min-height:76px; border-radius:var(--r-md); border:2px solid var(--border);
  background:var(--surface); color:var(--ink); font-size:22px; font-weight:800; cursor:pointer;
  display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px;
  transition:transform 140ms var(--ease), border-color 150ms;
}
.scale-btn small{ font-size:10.5px; font-weight:600; color:var(--ink-muted); }
.scale-btn:hover{ transform:translateY(-2px); }
.scale-btn.picked{ border-color:var(--gold); background:var(--gold-dim); color:var(--gold-ink); }

.rank-item{
  display:flex; align-items:center; gap:10px; padding:12px 13px; border-radius:var(--r-md);
  border:1px solid var(--border); background:var(--surface); margin-bottom:8px;
}
.rank-item .pos{ width:28px; height:28px; border-radius:8px; background:var(--gold-dim); color:var(--gold-ink); display:grid; place-items:center; font-weight:800; font-size:14px; flex:none; }

/* ===================== จอฉาย ===================== */
.screen{
  min-height:100vh; min-height:100dvh; display:flex; flex-direction:column;
  padding:clamp(16px,2.4vw,34px); gap:clamp(10px,1.6vw,22px);
  padding-top:max(clamp(16px,2.4vw,34px), env(safe-area-inset-top));
  padding-left:max(clamp(16px,2.4vw,34px), env(safe-area-inset-left));
  padding-right:max(clamp(16px,2.4vw,34px), env(safe-area-inset-right));
  padding-bottom:max(clamp(16px,2.4vw,34px), env(safe-area-inset-bottom));
}
.screen-head{ display:flex; align-items:flex-start; gap:var(--sp-4); }
.screen-q{ font-size:clamp(22px,3.1vw,46px); font-weight:800; letter-spacing:-.02em; line-height:1.2; flex:1; min-width:0; }
.screen-body{ flex:1; min-height:0; display:flex; flex-direction:column; justify-content:center; }
.screen-foot{ display:flex; align-items:center; gap:var(--sp-4); flex-wrap:wrap; color:var(--ink-2); font-size:clamp(12px,1.1vw,16px); }
.joinbox{ display:flex; align-items:center; gap:14px; padding:10px 16px; border-radius:var(--r-lg); background:var(--surface); border:1px solid var(--gold-dim); }
.joinbox .big{ font-size:clamp(20px,2.4vw,34px); font-weight:800; letter-spacing:.2em; color:var(--gold-ink); font-variant-numeric:tabular-nums; }
.screen .hero-num{ font-size:clamp(44px,8vw,120px); font-weight:800; letter-spacing:-.03em; line-height:1; }
.countdown{ font-size:clamp(70px,16vw,220px); font-weight:800; line-height:1; color:var(--gold-ink); letter-spacing:-.04em; }
.veil{ display:grid; place-items:center; gap:var(--sp-4); text-align:center; padding:var(--sp-7) 0; }
.veil .lock{ font-size:clamp(40px,7vw,90px); }

/* ===================== กราฟ ===================== */
.chart{ width:100%; display:block; overflow:visible; }
.chart text{ font-family:var(--font); }
.axis-line{ stroke:var(--axis); stroke-width:1; }
.grid-line{ stroke:var(--grid); stroke-width:1; }
.tick-txt{ fill:var(--ink-muted); font-size:12px; font-variant-numeric:tabular-nums; }
.lbl-txt{ fill:var(--ink); font-weight:600; }
.val-txt{ fill:var(--ink); font-weight:700; font-variant-numeric:tabular-nums; }
.sub-txt{ fill:var(--ink-muted); font-variant-numeric:tabular-nums; }
.bar-rect{ transition:width var(--dur) var(--ease), height var(--dur) var(--ease), y var(--dur) var(--ease), x var(--dur) var(--ease); }
.mark-hit{ fill:transparent; cursor:pointer; }
.slice{ transition:opacity 160ms; cursor:pointer; }
.chart-wrap{ position:relative; }

.legend{ display:flex; flex-wrap:wrap; gap:10px 18px; margin-top:var(--sp-3); }
.legend-item{ display:inline-flex; align-items:center; gap:7px; font-size:clamp(12px,1.05vw,15px); color:var(--ink-2); font-weight:600; }
.legend-item .sw{ width:12px; height:12px; border-radius:3px; flex:none; }

.tip{
  position:absolute; pointer-events:none; z-index:60; opacity:0; transform:translate(-50%,-115%);
  background:var(--surface); color:var(--ink); border:1px solid var(--border);
  border-radius:var(--r-sm); padding:8px 11px; font-size:13px; box-shadow:var(--shadow);
  transition:opacity 120ms; white-space:nowrap; font-weight:600;
}
.tip.on{ opacity:1; }
.tip .tv{ font-variant-numeric:tabular-nums; color:var(--ink-2); font-weight:600; }

.tbl{ width:100%; border-collapse:collapse; font-size:14px; }
.tbl th,.tbl td{ text-align:left; padding:9px 12px; border-bottom:1px solid var(--border-2); }
.tbl th{ color:var(--ink-muted); font-size:12.5px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; }
.tbl td.num{ text-align:right; font-variant-numeric:tabular-nums; font-weight:600; }
.tbl tbody tr:hover{ background:var(--surface-hi); }

/* heatmap */
.hm-cell{ transition:fill var(--dur) var(--ease); cursor:pointer; }
.hm-val{ font-size:12px; font-weight:700; font-variant-numeric:tabular-nums; }
.scale-legend{ display:flex; align-items:center; gap:8px; font-size:12.5px; color:var(--ink-muted); margin-top:var(--sp-3); }
.scale-legend .steps{ display:flex; }
.scale-legend .steps i{ width:26px; height:11px; display:block; }

/* word cloud */
.cloud{ display:flex; flex-wrap:wrap; gap:6px 16px; align-items:baseline; justify-content:center; padding:var(--sp-4) 0; }
.cloud span{ font-weight:700; line-height:1.15; transition:transform 200ms var(--ease); cursor:default; }
.cloud span:hover{ transform:scale(1.07); }

/* sticky notes */
.notes{ display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:var(--sp-3); }
.note{
  padding:var(--sp-4); border-radius:var(--r-md); background:var(--surface); border:1px solid var(--border-2);
  border-left:4px solid var(--c,var(--s1)); display:flex; flex-direction:column; gap:8px; box-shadow:var(--shadow);
  animation:notein 380ms var(--ease) both;
}
@keyframes notein{ from{ opacity:0; transform:translateY(10px) scale(.98);} to{ opacity:1; transform:none;} }
.note .txt{ font-size:15px; line-height:1.5; white-space:pre-wrap; word-break:break-word; }
.note .by{ font-size:12px; color:var(--ink-muted); font-weight:600; }
.note.hidden-note{ opacity:.42; }
.theme-group{ border:1px solid var(--border-2); border-radius:var(--r-md); padding:var(--sp-4); background:var(--plane-2); }
.theme-group h4{ font-size:15px; margin-bottom:6px; }

/* ===================== อื่น ๆ ===================== */
.modal-back{
  position:fixed; inset:0; z-index:90; background:rgba(3,8,16,.62); backdrop-filter:blur(4px);
  display:grid; place-items:center; padding:var(--sp-4); animation:fade 180ms var(--ease);
}
