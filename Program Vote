<body data-palette="#3987e5,#d95926,#199e70,#c98500,#d55181,#0ca30c,#9085e9,#e66767">
<div id="app"></div>
<div class="toast-stack" id="toasts" aria-live="polite"></div>
<div id="modalRoot"></div>

<script>
/* ============================================================
   ระบบโหวตและแสดงผลสด (Live Vote)
   สถาปัตยกรรม: Local-first — ข้อมูลทั้งหมดอยู่ในเครื่องผู้ใช้
   ไม่มีการส่งข้อมูลออกนอกเครื่อง ไม่ต้องใช้อินเทอร์เน็ต
   ซิงก์ระหว่างแท็บ/หน้าต่างด้วย BroadcastChannel + localStorage
   ============================================================ */
'use strict';

/* ---------- 1) ยูทิลิตี ---------- */
const U = {
  esc(s){ return String(s==null?'':s).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); },
  uid(p){ return (p||'x') + Math.random().toString(36).slice(2,9) + Date.now().toString(36).slice(-3); },
  n(x){ return Number(x||0).toLocaleString('th-TH'); },
  pct(a,b){ return b>0 ? Math.round(a/b*1000)/10 : 0; },
  code(){ let s=''; for(let i=0;i<6;i++) s+=Math.floor(Math.random()*10); return s; },
  clamp(v,a,b){ return Math.max(a,Math.min(b,v)); },
  dt(ts){ try{ return new Date(ts).toLocaleString('th-TH',{dateStyle:'medium',timeStyle:'short'}); }catch(e){ return ''; } },
  // สร้าง element แบบสั้น
  h(tag, attrs, kids){
    const e = document.createElement(tag);
    if(attrs) for(const k in attrs){
      const v = attrs[k];
      if(v==null || v===false) continue;
      if(k==='class') e.className=v;
      else if(k==='text') e.textContent=v;
      else if(k==='html') e.innerHTML=v;
      else if(k.startsWith('on')) e.addEventListener(k.slice(2), v);
      else if(k==='style' && typeof v==='object'){ for(const p in v) e.style.setProperty(p, v[p]); }
      else e.setAttribute(k, v);
    }
    if(kids) (Array.isArray(kids)?kids:[kids]).forEach(k=>{ if(k==null) return; e.appendChild(typeof k==='string'?document.createTextNode(k):k); });
    return e;
  },
  debounce(fn,ms){ let t; return (...a)=>{ clearTimeout(t); t=setTimeout(()=>fn(...a),ms); }; }
};
const $ = (s,r)=> (r||document).querySelector(s);
const $$ = (s,r)=> Array.from((r||document).querySelectorAll(s));

/* ---------- 2) ชั้นเก็บข้อมูล (ปลอดภัยต่อ localStorage ที่ใช้ไม่ได้) ---------- */
const LS = {
  ok: true,
  get(k){ try{ return localStorage.getItem(k); }catch(e){ LS.ok=false; return null; } },
  set(k,v){ try{ localStorage.setItem(k,v); return true; }catch(e){ LS.ok=false; return false; } },
  del(k){ try{ localStorage.removeItem(k); }catch(e){} },
  keys(){ try{ return Object.keys(localStorage); }catch(e){ LS.ok=false; return []; } },
  getJSON(k,d){ const v=LS.get(k); if(!v) return d; try{ return JSON.parse(v); }catch(e){ return d; } },
  setJSON(k,o){ return LS.set(k, JSON.stringify(o)); }
};
const K = {
  meta: c=>`lv2:${c}:meta`,              // เจ้าของ: ผู้ดำเนินการ (host)
  p:   (c,pid)=>`lv2:${c}:p:${pid}`,     // เจ้าของ: ผู้เข้าร่วมแต่ละคน (ไม่ชนกัน)
  pPrefix: c=>`lv2:${c}:p:`,
  rooms: 'lv2:rooms',                    // รายการรหัสห้องที่เคยสร้าง
  myPid: c=>`lv2:${c}:mypid`,
  theme: 'lv2:theme'
};

/* คลังข้อมูลห้อง — อ่าน/เขียนแยกคีย์ จึงไม่มีการเขียนทับกันระหว่างแท็บ */
const Store = {
  listRooms(){ return LS.getJSON(K.rooms, []).filter(r=>r && r.code); },
  rememberRoom(room){
    const rs = Store.listRooms().filter(r=>r.code!==room.code);
    rs.unshift({ code:room.code, title:room.title, createdAt:room.createdAt, sync:room.sync||'local', dbHost:room.dbHost||'' });
    LS.setJSON(K.rooms, rs.slice(0,30));
  },
  forgetRoom(code){
    LS.setJSON(K.rooms, Store.listRooms().filter(r=>r.code!==code));
    LS.keys().filter(k=>k.startsWith(`lv2:${code}:`)).forEach(LS.del);
  },
  getMeta(code){ return LS.getJSON(K.meta(code), null); },
  setMeta(code, meta){ meta.rev=(meta.rev||0)+1; LS.setJSON(K.meta(code), meta); Bus.send({t:'meta',code}); return meta; },
  people(code){
    const pre = K.pPrefix(code);
    return LS.keys().filter(k=>k.startsWith(pre)).map(k=>LS.getJSON(k,null)).filter(Boolean)
      .sort((a,b)=>(a.joinedAt||0)-(b.joinedAt||0));
  },
  getPerson(code,pid){ return LS.getJSON(K.p(code,pid), null); },
  setPerson(code, p){ LS.setJSON(K.p(code,p.pid), p); Bus.send({t:'person',code,pid:p.pid}); },
  delPerson(code,pid){ LS.del(K.p(code,pid)); Bus.send({t:'person',code,pid}); },
  clearVotes(code, opts){
    Store.people(code).forEach(p=>{
      if(opts && opts.simOnly && !p.sim) return;
      if(opts && opts.removeSim && p.sim){ LS.del(K.p(code,p.pid)); return; }
      p.answers = {}; LS.setJSON(K.p(code,p.pid), p);
    });
    Bus.send({t:'person',code});
  }
};

/* ---------- 3) บัสซิงก์ระหว่างแท็บ/หน้าต่าง ---------- */
const Bus = {
  ch: null, subs: [],
  init(){
    try{ Bus.ch = new BroadcastChannel('livevote2'); Bus.ch.onmessage = e=>Bus.fire(e.data); }catch(e){ Bus.ch=null; }
    // สำรอง: storage event ทำงานข้ามแท็บเสมอ (ยิงเฉพาะแท็บอื่น)
    window.addEventListener('storage', e=>{
      if(!e.key || !e.key.startsWith('lv2:')) return;
      const m = e.key.match(/^lv2:(\d+):/);
      Bus.fire({ t: e.key.includes(':p:')?'person':'meta', code: m?m[1]:null, _ls:true });
    });
  },
  send(msg){ try{ if(Bus.ch) Bus.ch.postMessage(msg); }catch(e){} },
  on(fn){ Bus.subs.push(fn); return ()=>{ Bus.subs = Bus.subs.filter(f=>f!==fn); }; },
  fire(msg){ Bus.subs.forEach(f=>{ try{ f(msg); }catch(e){ console.error(e); } }); }
};

/* ---------- 4) นิยามชนิดคำถาม ---------- */
const QTYPES = {
  single:{ label:'เลือกข้อเดียว', icon:'◉', charts:['bar','donut','stacked'], def:'bar' },
  multi: { label:'เลือกหลายข้อ', icon:'☑', charts:['bar','stacked'], def:'bar' },
  yesno: { label:'เห็นด้วย / ไม่เห็นด้วย / งดออกเสียง', icon:'⚖', charts:['bar','donut','stacked'], def:'bar' },
  scale: { label:'สเกลคะแนน (Likert)', icon:'▦', charts:['scale','stacked'], def:'scale' },
  rank:  { label:'จัดอันดับความสำคัญ', icon:'↕', charts:['bar'], def:'bar' },
  text:  { label:'ข้อความ / ความเห็นอิสระ', icon:'✎', charts:['notes','cloud'], def:'notes' }
};
const CHART_LABEL = { bar:'แท่งแนวนอน', donut:'โดนัท', stacked:'แท่งซ้อนแยกกลุ่ม', scale:'สเกล + ค่าเฉลี่ย', cloud:'Word Cloud', notes:'การ์ดความเห็น', heatmap:'Heatmap' };
const YESNO_OPTS = [{id:'yes',label:'เห็นด้วย'},{id:'no',label:'ไม่เห็นด้วย'},{id:'abstain',label:'งดออกเสียง'}];
const SCALE_PRESET = ['ไม่เห็นด้วยอย่างยิ่ง','ไม่เห็นด้วย','เฉย ๆ','เห็นด้วย','เห็นด้วยอย่างยิ่ง'];

/* สีข้อมูล: ผูกกับ "ตัวตน" ของตัวเลือกตามลำดับที่สร้าง (ไม่เปลี่ยนตามอันดับคะแนน) */
function slotVar(i){ return `var(--s${(i%8)+1})`; }
function optColor(q, idx){
  if(q && q.type==='yesno') return ['var(--s6)','var(--s8)','var(--ink-muted)'][idx] || slotVar(idx);
  return slotVar(idx);
}
/* ตัวอักษรบนพื้นสีข้อมูล: ขาว ยกเว้นสีเหลืองในโหมดสว่าง (ตามกฎ label-in-fill) */
function inkOnSlot(idx){
  const light = document.documentElement.dataset.theme==='light';
  return (light && (idx%8)===3) ? '#0b0b0b' : '#ffffff';
}
function optsOf(q){ return q.type==='yesno' ? YESNO_OPTS : (q.options||[]); }

/* ชื่อที่ใช้แสดง — ชื่อเล่นอ่านง่ายกว่าบนจอฉาย */
function displayName(p){
  if(!p) return 'ไม่ระบุชื่อ';
  return p.nickname || p.name || ('ผู้ตอบ '+String(p.pid||'').slice(-4));
}
/* ชื่อเต็มพร้อมรหัส — ใช้ในตารางผู้เข้าร่วมและไฟล์ส่งออก */
function fullName(p){
  if(!p) return 'ไม่ระบุชื่อ';
  const a=[];
  if(p.name) a.push(p.name);
  if(p.nickname) a.push('('+p.nickname+')');
  if(p.studentId) a.push('รหัส '+p.studentId);
  return a.join(' ') || 'ไม่ระบุชื่อ';
}

/* ---------- 5) การนับผล ---------- */
function answersFor(people, qid){
  const out=[];
  people.forEach(p=>{ const v=p.answers&&p.answers[qid]; if(v!==undefined && v!==null && v!=='' && !(Array.isArray(v)&&!v.length)) out.push({p, v}); });
  return out;
}
function tally(q, people){
  const list = answersFor(people, q.id);
  const opts = optsOf(q);
  const res = { n:list.length, list, opts, rows:[], total:0 };

  if(q.type==='single' || q.type==='yesno'){
    const c={}; opts.forEach(o=>c[o.id]=0);
    list.forEach(({v})=>{ if(c[v]!==undefined) c[v]++; });
    res.total = list.length;
    res.rows = opts.map((o,i)=>({ id:o.id, label:o.label, value:c[o.id], idx:i }));
  }
  else if(q.type==='multi'){
    const c={}; opts.forEach(o=>c[o.id]=0);
    list.forEach(({v})=>{ (Array.isArray(v)?v:[v]).forEach(x=>{ if(c[x]!==undefined) c[x]++; }); });
    res.total = list.length;  // ฐาน = จำนวนผู้ตอบ (เลือกได้หลายข้อ จึงรวมเกิน 100% ได้)
    res.rows = opts.map((o,i)=>({ id:o.id, label:o.label, value:c[o.id], idx:i }));
    res.multi = true;
  }
  else if(q.type==='scale'){
    const min=q.scaleMin||1, max=q.scaleMax||5;
    const c={}; for(let s=min;s<=max;s++) c[s]=0;
    let sum=0;
    list.forEach(({v})=>{ const x=Number(v); if(c[x]!==undefined){ c[x]++; sum+=x; } });
    res.total = list.length;
    res.avg = list.length ? sum/list.length : 0;
    res.min=min; res.max=max;
    res.rows = Object.keys(c).map((s,i)=>({ id:s, label:String(s), value:c[s], idx:i,
      sub:(q.scaleLabels&&q.scaleLabels[i])||'' }));
    // ค่าเบี่ยงเบนมาตรฐาน ช่วยดูความเห็นแตกแยก
    if(list.length>1){
      const m=res.avg; let s2=0; list.forEach(({v})=>{ s2+=Math.pow(Number(v)-m,2); });
      res.sd = Math.sqrt(s2/(list.length-1));
    } else res.sd = 0;
  }
  else if(q.type==='rank'){
    // คะแนนแบบ Borda: อันดับ 1 ได้ N คะแนน ลดหลั่นลงมา
    const c={}; opts.forEach(o=>c[o.id]=0);
    const N = opts.length;
    list.forEach(({v})=>{ (Array.isArray(v)?v:[]).forEach((id,pos)=>{ if(c[id]!==undefined) c[id]+=(N-pos); }); });
    res.total = Object.values(c).reduce((a,b)=>a+b,0);
    res.rows = opts.map((o,i)=>({ id:o.id, label:o.label, value:c[o.id], idx:i }));
    res.borda = true; res.maxPossible = N*list.length;
  }
  else if(q.type==='text'){
    res.texts = list.map(({p,v})=>({ pid:p.pid, name:p.name, nickname:p.nickname, studentId:p.studentId, group:p.group, text:String(v), sim:!!p.sim }));
    res.total = res.texts.length;
  }
  return res;
}
/* นับแยกตามกลุ่ม (สำหรับแท่งซ้อน / heatmap) */
function tallyByGroup(q, people, groups){
  const opts = optsOf(q);
  const gs = (groups&&groups.length?groups:['ไม่ระบุกลุ่ม']);
  const grid = {};
  gs.forEach(g=> grid[g] = Object.fromEntries(opts.map(o=>[o.id,0])) );
  const other = Object.fromEntries(opts.map(o=>[o.id,0]));
  let any=false;
  answersFor(people,q.id).forEach(({p,v})=>{
    const bucket = grid[p.group] || other;
    if(!grid[p.group]) any=true;
    const vals = q.type==='multi' ? (Array.isArray(v)?v:[v]) : (q.type==='rank' ? [] : [String(v)]);
    vals.forEach(x=>{ if(bucket[x]!==undefined) bucket[x]++; });
  });
  const rows = gs.map(g=>({ group:g, counts:grid[g] }));
  if(any) rows.push({ group:'ไม่ระบุกลุ่ม', counts:other });
  return { rows: rows.filter(r=> Object.values(r.counts).some(v=>v>0) || gs.includes(r.group)), opts };
}
/* ============================================================
   6) กราฟ (SVG เขียนเอง — ไม่พึ่งไลบรารีภายนอก จึงทำงานออฟไลน์ได้)
   หลักการ: วาดขนาดจริง 1:1 ตามความกว้างที่วัดได้ (ตัวอักษรจึงคมและ
   ขนาดตรงตามออกแบบทั้งบนมือถือและจอโปรเจกเตอร์)
   ป้ายค่ากำกับทุกแท่ง + มีตารางข้อมูลคู่กัน จึงอ่านค่าได้โดยไม่พึ่งสี
   ============================================================ */
const SVGNS = 'http://www.w3.org/2000/svg';
const ANIM = {};                      // จำขนาดเดิม เพื่อให้ค่าที่เปลี่ยนเคลื่อนไหวอย่างลื่นไหล
let CHART_RESIZE = [];                // ตัวจัดการ resize ที่ต้องถอดเมื่อวาดหน้าใหม่
function clearChartListeners(){
  CHART_RESIZE.forEach(f=>{ try{ window.removeEventListener('resize',f); }catch(e){} });
  CHART_RESIZE = [];
}
function sv(tag, attrs){
  const e = document.createElementNS(SVGNS, tag);
  for(const k in (attrs||{})){ const v=attrs[k]; if(v!=null) e.setAttribute(k, v); }
  return e;
}
function animKey(q, id){ return `${q.id}|${id}`; }

/* วัดความกว้างข้อความจริง เพื่อไม่ให้ป้ายล้นหรือถูกตัดกลางคำ */
let _mctx = null, _mctxTried = false;
function textW(str, fs, weight){
  try{
    if(!_mctxTried){ _mctxTried = true; const c=document.createElement('canvas'); _mctx=c.getContext('2d'); }
    if(_mctx){
      const fam = getComputedStyle(document.body).fontFamily || 'sans-serif';
      _mctx.font = `${weight||600} ${fs}px ${fam}`;
      return _mctx.measureText(String(str||'')).width;
    }
  }catch(e){}
  return String(str||'').length * fs * 0.58;   // ประมาณการเมื่อวัดไม่ได้
}
function fitText(str, maxPx, fs, weight){
  str = String(str==null?'':str);
  if(textW(str,fs,weight) <= maxPx) return str;
  let lo=0, hi=str.length;
  while(lo<hi){ const mid=Math.ceil((lo+hi)/2); if(textW(str.slice(0,mid)+'…',fs,weight)<=maxPx) lo=mid; else hi=mid-1; }
  return lo>0 ? str.slice(0,lo)+'…' : '';
}

/* กล่องกราฟ + tooltip ร่วม */
function chartWrap(){
  const w = U.h('div',{class:'chart-wrap'});
  const tip = U.h('div',{class:'tip',role:'status'});
  w.appendChild(tip); w._tip = tip;
  return w;
}
function bindTip(wrap, hit, html){
  hit.addEventListener('pointerenter', ()=>{ wrap._tip.innerHTML = html; wrap._tip.classList.add('on'); });
  hit.addEventListener('pointerleave', ()=>{ wrap._tip.classList.remove('on'); });
  hit.addEventListener('pointermove', ev=>{
    const r = wrap.getBoundingClientRect();
    wrap._tip.style.left = (ev.clientX - r.left)+'px';
    wrap._tip.style.top  = (ev.clientY - r.top)+'px';
  });
}
/* วาดเมื่อรู้ความกว้างจริงแล้ว และวาดใหม่เมื่อขนาดหน้าต่างเปลี่ยน */
function autoChart(build, fallbackW){
  const wrap = chartWrap();
  const draw = ()=>{
    const W = Math.max(300, Math.round(wrap.clientWidth || fallbackW || 900));
    Array.from(wrap.children).forEach(n=>{ if(n!==wrap._tip) n.remove(); });
    build(wrap, W);
  };
  requestAnimationFrame(draw);
  const deb = U.debounce(draw, 160);
  window.addEventListener('resize', deb); CHART_RESIZE.push(deb);
  return wrap;
}

/* ---------- 6.1 แท่งแนวนอน — ป้ายชื่ออยู่เหนือแท่ง ---------- */
/* วางป้ายไว้เหนือแท่ง ทำให้ข้อความไทยยาวเท่าใดก็ไม่ล้นหรือทับแท่ง
   และตัวอักษรอยู่บนพื้นหลังปกติเสมอ จึงอ่านง่ายทั้งโหมดสว่างและมืด */
function barChart(q, t, o){
  o = o||{};
  const big = !!o.big;
  const rows = t.rows.slice().sort((a,b)=>b.value-a.value);
  const n = rows.length;
  return autoChart((wrap, W)=>{
    const labelFS = big ? (n<=4?34:(n<=6?28:23)) : 14.5;
    const valFS   = big ? (n<=4?35:(n<=6?29:24)) : 15;
    const barH    = big ? (n<=4?54:(n<=6?42:32)) : 18;
    const gap     = big ? (n<=4?30:(n<=6?25:18)) : 13;
    const labelH  = labelFS + (big?15:9);
    const rowH    = labelH + barH + gap;
    const H       = Math.max(1, n*rowH - gap + 4);
    const denom   = t.borda ? Math.max(1,...rows.map(r=>r.value)) : Math.max(1, t.total);

    const svg = sv('svg',{class:'chart',viewBox:`0 0 ${W} ${H}`,width:W,height:H,
      style:'width:100%;height:auto',role:'img','aria-label':`ผลโหวต ${q.text}`});

    rows.forEach((r,i)=>{
      const yTop = i*rowH;
      const g = sv('g');
      const valStr = t.borda ? `${U.n(r.value)} คะแนน` : `${U.n(r.value)} · ${U.pct(r.value,t.total)}%`;
      const vW = textW(valStr, valFS, 700);
      const labelMax = Math.max(40, W - vW - (big?28:18));

      // ป้ายชื่อตัวเลือก (ใช้สีตัวอักษรปกติ ไม่ใช้สีของข้อมูล)
      const tx = sv('text',{class:'lbl-txt',x:0,y:yTop+labelFS,style:`font-size:${labelFS}px`});
      tx.textContent = fitText(r.label + (r.sub? '  ·  '+r.sub : ''), labelMax, labelFS, 600);
      g.appendChild(tx);

      // ค่าตัวเลขและร้อยละ — ป้ายกำกับตรง ๆ ทุกแท่ง (อ่านค่าได้โดยไม่ต้องพึ่งสี)
      const vt = sv('text',{class:'val-txt',x:W,y:yTop+labelFS,'text-anchor':'end',style:`font-size:${valFS}px`});
      vt.textContent = valStr;
      g.appendChild(vt);

      // รางอ้างอิง = 100% ของผู้ตอบ ทำให้เห็นสัดส่วนจริง
      g.appendChild(sv('rect',{x:0,y:yTop+labelH,width:W,height:barH,rx:4,fill:'var(--grid)'}));

      const wTarget = Math.max(r.value>0?5:0, (r.value/denom)*W);
      const key = animKey(q, r.id);
      const wPrev = ANIM[key]==null ? 0 : Math.min(ANIM[key], W);
      ANIM[key] = wTarget;
      const col = optColor(q, r.idx);
      const rect = sv('rect',{class:'bar-rect',x:0,y:yTop+labelH,width:wPrev,height:barH,rx:4,fill:col});
      const patch = sv('rect',{class:'bar-rect',x:0,y:yTop+labelH,width:Math.min(4,wPrev),height:barH,fill:col});
      g.appendChild(rect); g.appendChild(patch);

      const hit = sv('rect',{class:'mark-hit',x:0,y:yTop,width:W,height:rowH});
      g.appendChild(hit);
      bindTip(wrap, hit, `<b>${U.esc(r.label)}</b><br><span class="tv">${U.n(r.value)} ${t.borda?'คะแนน':'เสียง'} · ${U.pct(r.value,t.total)}%</span>`);
      svg.appendChild(g);
      requestAnimationFrame(()=>{ rect.setAttribute('width',wTarget); patch.setAttribute('width',Math.min(4,wTarget)); });
    });
    wrap.appendChild(svg);
    // ป้ายชื่ออยู่ติดกับแท่งของตัวเองอยู่แล้ว จึงไม่ต้องมีกล่องคำอธิบายสีซ้ำอีก
  }, o.big?1200:700);
}

/* ---------- 6.2 โดนัท ---------- */
function donutChart(q, t, o){
  o=o||{}; const big=!!o.big;
  const wrap = chartWrap();
  const size = big? 470 : 290, R = size/2 - (big?40:26), SW = big? 46 : 30, C = 2*Math.PI*R;
  const total = t.rows.reduce((a,r)=>a+r.value,0);
  const svg = sv('svg',{class:'chart',viewBox:`0 0 ${size} ${size}`,width:size,height:size,
    style:`width:100%;max-width:${size}px;height:auto;margin:0 auto`,role:'img','aria-label':`ผลโหวต ${q.text}`});
  const g = sv('g',{transform:`translate(${size/2},${size/2}) rotate(-90)`});
  svg.appendChild(g);
  g.appendChild(sv('circle',{r:R,fill:'none',stroke:'var(--grid)','stroke-width':SW}));

  let acc=0;
  const GAP = total>0 ? Math.min(C*0.012, 9) : 0;      // ช่องว่างสีพื้นคั่นทุกส่วน
  t.rows.forEach(r=>{
    if(!r.value) return;
    const frac = r.value/total;
    const len = Math.max(0, frac*C - GAP);
    const key = animKey(q,'d'+r.id);
    const prev = ANIM[key]==null?0:ANIM[key]; ANIM[key]=len;
    const c = sv('circle',{class:'slice',r:R,fill:'none',stroke:optColor(q,r.idx),'stroke-width':SW,
      'stroke-dasharray':`${prev} ${C}`,'stroke-dashoffset':-(acc*C)-GAP/2,'stroke-linecap':'butt'});
    c.style.transition = 'stroke-dasharray var(--dur) var(--ease)';
    g.appendChild(c);
    const hit = sv('circle',{class:'mark-hit',r:R,fill:'none',stroke:'transparent','stroke-width':SW+16,
      'stroke-dasharray':`${len} ${C}`,'stroke-dashoffset':-(acc*C)});
    g.appendChild(hit);
    bindTip(wrap, hit, `<b>${U.esc(r.label)}</b><br><span class="tv">${U.n(r.value)} เสียง · ${U.pct(r.value,total)}%</span>`);
    acc += frac;
    requestAnimationFrame(()=>c.setAttribute('stroke-dasharray', `${len} ${C}`));
  });
  const t1 = sv('text',{x:size/2,y:size/2,'text-anchor':'middle',class:'val-txt',style:`font-size:${big?'54px':'34px'}`});
  t1.textContent = U.n(total);
  const t2 = sv('text',{x:size/2,y:size/2+(big?34:24),'text-anchor':'middle',class:'sub-txt',style:`font-size:${big?'19px':'13px'}`});
  t2.textContent = 'ผู้ตอบ';
  svg.appendChild(t1); svg.appendChild(t2);
  wrap.appendChild(svg);
  // วงกลมอ่านค่าที่ใกล้เคียงกันยาก จึงพิมพ์ชื่อ+จำนวน+ร้อยละกำกับไว้ใต้กราฟเสมอ
  const lg = U.h('div',{class:'legend'});
  t.rows.forEach(r=>{
    lg.appendChild(U.h('span',{class:'legend-item'},[
      U.h('i',{class:'sw',style:{background:optColor(q,r.idx)}}),
      document.createTextNode(`${r.label} — ${U.n(r.value)} (${U.pct(r.value,total)}%)`)
    ]));
  });
  wrap.appendChild(lg);
  return wrap;
}

/* ---------- 6.3 แท่งซ้อน แยกตามกลุ่มผู้ตอบ ---------- */
function stackedChart(q, people, groups, o){
  o=o||{}; const big=!!o.big;
  const { rows, opts } = tallyByGroup(q, people, groups);
  const n = Math.max(1, rows.length);
  const wrap = autoChart((wp, W)=>{
    const fs = big? (n<=4?23:19) : 13.5;
    const barH = big? (n<=4?40:32) : 24;
    const band = barH + (big?30:16);
    const labelW = Math.min(W*0.3, big?300:180);
    const totW = big? 84 : 54;
    const plotW = Math.max(60, W - labelW - totW - 16);
    const H = n*band;
    const maxTotal = Math.max(1, ...rows.map(r=>Object.values(r.counts).reduce((a,b)=>a+b,0)));
    const svg = sv('svg',{class:'chart',viewBox:`0 0 ${W} ${H}`,width:W,height:H,
      style:'width:100%;height:auto',role:'img','aria-label':'ผลโหวตแยกตามกลุ่มผู้ตอบ'});

    rows.forEach((r,i)=>{
      const y = i*band + (big?8:4);
      const tot = Object.values(r.counts).reduce((a,b)=>a+b,0);
      const nm = sv('text',{class:'lbl-txt',x:0,y:y+barH/2+fs*0.36,style:`font-size:${fs}px`});
      nm.textContent = fitText(r.group, labelW-12, fs, 600);
      svg.appendChild(nm);
      let x = labelW;
      const GAP = 2;                                   // ช่องว่างสีพื้น 2px คั่นทุกส่วน
      opts.forEach((op,oi)=>{
        const v = r.counts[op.id]||0; if(!v) return;
        const w = Math.max(3, (v/maxTotal)*plotW - GAP);
        const key = animKey(q,`st${i}_${op.id}`);
        const prev = ANIM[key]==null?0:ANIM[key]; ANIM[key]=w;
        const rect = sv('rect',{class:'bar-rect',x:x,y:y,width:prev,height:barH,rx:4,fill:optColor(q,oi)});
        svg.appendChild(rect);
        const hit = sv('rect',{class:'mark-hit',x:x,y:y-4,width:w+GAP,height:barH+8});
        svg.appendChild(hit);
        bindTip(wp, hit, `<b>${U.esc(r.group)}</b><br>${U.esc(op.label)}<br><span class="tv">${U.n(v)} เสียง · ${U.pct(v,tot)}%</span>`);
        x += w + GAP;
        requestAnimationFrame(()=>rect.setAttribute('width', w));
      });
      const vt = sv('text',{class:'val-txt',x:W,y:y+barH/2+fs*0.36,'text-anchor':'end',style:`font-size:${fs}px`});
      vt.textContent = U.n(tot); svg.appendChild(vt);
    });
    wp.appendChild(svg);
    wp.appendChild(legendOf(q, opts.map((o2,i)=>({id:o2.id,label:o2.label,idx:i}))));
  }, o.big?1200:700);
  return wrap;
}
function legendOf(q, rows){
  const L = U.h('div',{class:'legend'});
  if(rows.length < 2) return L;
  rows.forEach(r=>{
    L.appendChild(U.h('span',{class:'legend-item'},[
      U.h('i',{class:'sw',style:{background:optColor(q,r.idx)}}),
      document.createTextNode(r.label)
    ]));
  });
  return L;
}

/* ---------- 6.4 สเกล (ไล่เฉดสีเดียวตามลำดับ) + ค่าเฉลี่ยเป็นเลขเด่น ---------- */
function scaleChart(q, t, o){
  o=o||{}; const big=!!o.big;
  const box = U.h('div',{class:'col'});
  const stat = (label, value, hint)=> U.h('div',{},[
    U.h('div',{class:'muted',style:{'font-size':big?'17px':'13px','font-weight':'600'},text:label}),
    U.h('div',{style:{'font-size':big?'clamp(40px,5vw,78px)':'38px','font-weight':'800','line-height':'1.05'},text:value}),
    hint? U.h('div',{class:'hint',text:hint}) : null
  ]);
  const head = U.h('div',{class:'row row-wrap',style:{'align-items':'flex-end',gap:'34px'}});
  head.appendChild(stat('ค่าเฉลี่ย', t.n? t.avg.toFixed(2) : '—', `จากเต็ม ${t.max}`));
  head.appendChild(stat('ผู้ตอบ', U.n(t.n), ''));
  if(t.n>1) head.appendChild(stat('ส่วนเบี่ยงเบนมาตรฐาน', t.sd.toFixed(2),
    t.sd>=1.3?'ความเห็นกระจายมาก':(t.sd<=0.7?'ความเห็นค่อนข้างตรงกัน':'ความเห็นกระจายปานกลาง')));
  box.appendChild(head);

  box.appendChild(autoChart((wp, W)=>{
    const n = t.rows.length;
    const fs = big? 26 : 15, subFS = big? 15 : 11, valFS = big? 22 : 13.5;
    const plotH = big? 260 : 150;
    const footH = big? (t.rows.some(r=>r.sub)? 74 : 44) : (t.rows.some(r=>r.sub)? 46:28);
    const H = plotH + footH;
    const colW = W/n, barW = Math.min(big?104:52, colW*0.56);
    const maxV = Math.max(1, ...t.rows.map(r=>r.value));
    const svg = sv('svg',{class:'chart',viewBox:`0 0 ${W} ${H}`,width:W,height:H,
      style:'width:100%;height:auto',role:'img','aria-label':'การกระจายคะแนน'});
    [0,.5,1].forEach(f=>{ const y=plotH-plotH*f; svg.appendChild(sv('line',{class:'grid-line',x1:0,y1:y,x2:W,y2:y})); });
    svg.appendChild(sv('line',{class:'axis-line',x1:0,y1:plotH,x2:W,y2:plotH}));

    const ramp = ['var(--o1)','var(--o2)','var(--o3)','var(--o4)','var(--o5)'];
    t.rows.forEach((r,i)=>{
      const col = ramp[Math.min(4, Math.round(i/Math.max(1,n-1)*4))];
      const h = maxV? (r.value/maxV)*(plotH-(big?46:30)) : 0;
      const x = i*colW + (colW-barW)/2;
      const key = animKey(q,'sc'+r.id);
      const prev = ANIM[key]==null?0:ANIM[key]; ANIM[key]=h;
      const rect = sv('rect',{class:'bar-rect',x:x,y:plotH-prev,width:barW,height:prev,rx:4,fill:col});
      const patch = sv('rect',{class:'bar-rect',x:x,y:plotH-4,width:barW,height:Math.min(4,prev),fill:col});
      svg.appendChild(rect); svg.appendChild(patch);
      const vt = sv('text',{class:'val-txt',x:x+barW/2,y:plotH-h-(big?14:8),'text-anchor':'middle',style:`font-size:${valFS}px`});
      vt.textContent = `${U.n(r.value)} · ${U.pct(r.value,t.total)}%`;
      svg.appendChild(vt);
      const nt = sv('text',{class:'lbl-txt',x:x+barW/2,y:plotH+(big?34:20),'text-anchor':'middle',style:`font-size:${fs}px`});
      nt.textContent = r.label; svg.appendChild(nt);
      if(r.sub){
        const st = sv('text',{class:'sub-txt',x:x+barW/2,y:plotH+(big?62:38),'text-anchor':'middle',style:`font-size:${subFS}px`});
        st.textContent = fitText(r.sub, colW-6, subFS, 400); svg.appendChild(st);
      }
      const hit = sv('rect',{class:'mark-hit',x:i*colW,y:0,width:colW,height:plotH});
      svg.appendChild(hit);
      bindTip(wp, hit, `<b>ระดับ ${r.label}${r.sub?(' · '+U.esc(r.sub)):''}</b><br><span class="tv">${U.n(r.value)} เสียง · ${U.pct(r.value,t.total)}%</span>`);
      requestAnimationFrame(()=>{ rect.setAttribute('height',h); rect.setAttribute('y',plotH-h); patch.setAttribute('height',Math.min(4,h)); });
    });
    wp.appendChild(svg);
  }, o.big?1200:700));
  return box;
}

/* ---------- 6.5 Heatmap: กลุ่มผู้ตอบ × ตัวเลือก (ไล่เฉดสีเดียว) ---------- */
function heatmapChart(q, people, groups, o){
  o=o||{}; const big=!!o.big;
  const { rows, opts } = tallyByGroup(q, people, groups);
  return autoChart((wp, W)=>{
    const fs = big? 21 : 12, valFS = big? 26 : 12.5;
    const cellH = big? 78 : 36, headH = big? 58 : 32;
    // ช่องค่าสูงเป็นสีอ่อนในโหมดกรมท่า และเป็นสีเข้มในโหมดสว่าง ตัวอักษรจึงต้องสลับตามธีม
    const lightTheme = document.documentElement.dataset.theme==='light';
    const labelW = Math.min(W*0.28, big?250:150);
    const cellW = (W-labelW)/Math.max(1,opts.length);
    const H = rows.length*cellH + headH;
    const maxV = Math.max(1, ...rows.flatMap(r=>Object.values(r.counts)));
    const steps = ['var(--q0)','var(--q1)','var(--q2)','var(--q3)','var(--q4)','var(--q5)','var(--q6)'];
    const svg = sv('svg',{class:'chart',viewBox:`0 0 ${W} ${H}`,width:W,height:H,
      style:'width:100%;height:auto',role:'img','aria-label':'ตารางความร้อนผลโหวตตามกลุ่ม'});

    opts.forEach((op,i)=>{
      const tx = sv('text',{class:'tick-txt',x:labelW+i*cellW+cellW/2,y:headH-12,'text-anchor':'middle',style:`font-size:${fs}px`});
      tx.textContent = fitText(op.label, cellW-10, fs, 400); svg.appendChild(tx);
    });
    rows.forEach((r,ri)=>{
      const y = headH + ri*cellH;
      const nm = sv('text',{class:'lbl-txt',x:0,y:y+cellH/2+fs*0.36,style:`font-size:${fs}px`});
      nm.textContent = fitText(r.group, labelW-12, fs, 600); svg.appendChild(nm);
      opts.forEach((op,ci)=>{
        const v = r.counts[op.id]||0;
        const si = v===0?0: 1+Math.round((v/maxV)*(steps.length-2));
        const x = labelW + ci*cellW;
        svg.appendChild(sv('rect',{class:'hm-cell',x:x+1,y:y+1,width:cellW-2,height:cellH-2,rx:4,fill:steps[si]}));
        const vt = sv('text',{class:'hm-val',x:x+cellW/2,y:y+cellH/2+valFS*0.36,'text-anchor':'middle',
          fill: si>=4 ? (lightTheme?'#ffffff':'#0b1120') : 'var(--ink-2)',
          opacity: v? 1 : .45, style:`font-size:${valFS}px`});
        vt.textContent = U.n(v);
        svg.appendChild(vt);
        const hit = sv('rect',{class:'mark-hit',x:x,y:y,width:cellW,height:cellH});
        svg.appendChild(hit);
        bindTip(wp, hit, `<b>${U.esc(r.group)}</b><br>${U.esc(op.label)}<br><span class="tv">${U.n(v)} เสียง</span>`);
      });
    });
    wp.appendChild(svg);
    const sl = U.h('div',{class:'scale-legend'},[ document.createTextNode('น้อย') ]);
    const st = U.h('div',{class:'steps'});
    steps.slice(1).forEach(s=> st.appendChild(U.h('i',{style:{background:s}})));
    sl.appendChild(st); sl.appendChild(document.createTextNode(`มาก (สูงสุด ${U.n(maxV)} เสียง)`));
    wp.appendChild(sl);
  }, o.big?1200:700);
}

/* ---------- 6.6 Word Cloud (ตัดคำไทย) ---------- */
const TH_STOP = new Set(['และ','หรือ','แต่','ที่','ซึ่ง','อัน','เป็น','คือ','ของ','ใน','กับ','แก่','จาก','โดย','ตาม','เพื่อ','ให้','ได้','แล้ว','ว่า','ไม่','มี','จะ','ก็','ด้วย','นี้','นั้น','มาก','ควร','ต้อง','การ','ความ','อย่าง','ถ้า','เมื่อ','จึง','ยัง','อยู่','ทำ','ขึ้น','ลง','ไป','มา','ครับ','ค่ะ','นะ','เลย','คง','น่า','ทั้ง','หนึ่ง','สอง','ผู้','ราย','เรื่อง','a','the','and','or','of','to','in','is','it','for','on','that','this','be','are','as','with','at','by','an','i']);
function segmentThai(s){
  s = String(s||'').replace(/[​-‍]/g,'');
  let toks=[];
  try{
    if(typeof Intl!=='undefined' && Intl.Segmenter){
      const seg = new Intl.Segmenter('th',{granularity:'word'});
      for(const x of seg.segment(s)) if(x.isWordLike) toks.push(x.segment);
    }
  }catch(e){}
  if(!toks.length) toks = s.split(/[\s,.!?;:()"'«»…ๆ\-\/\\|\[\]{}]+/);
  return toks.map(t=>t.trim()).filter(t=> t.length>1 && !TH_STOP.has(t.toLowerCase()) && !/^\d+$/.test(t));
}
function cloudView(q, t, o){
  o=o||{}; const big=!!o.big;
  const freq = new Map();
  (t.texts||[]).forEach(x=> segmentThai(x.text).forEach(w=> freq.set(w,(freq.get(w)||0)+1)) );
  const words = Array.from(freq.entries()).sort((a,b)=>b[1]-a[1]).slice(0, big?42:30);
  const box = U.h('div',{class:'col'});
  if(!words.length){ box.appendChild(U.h('p',{class:'muted',style:{'text-align':'center'},text:'ยังไม่มีคำที่นับได้'})); return box; }
  const max = words[0][1], min = words[words.length-1][1];
  const cloud = U.h('div',{class:'cloud'});
  const ramp = ['var(--o1)','var(--o2)','var(--o3)','var(--o4)','var(--o5)'];
  const shuffled = words.map((w,i)=>({w,i})).sort((a,b)=> (a.i%3)-(b.i%3) || a.i-b.i );
  shuffled.forEach(({w})=>{
    const [word,c] = w;
    const f = max===min? 1 : (c-min)/(max-min);
    cloud.appendChild(U.h('span',{
      style:{ 'font-size': ((big?22:15) + f*(big?62:34))+'px', color: ramp[Math.min(4,Math.round(f*4))] },
      title:`${word} — ${c} ครั้ง`, text: word }));
  });
  box.appendChild(cloud);
  // ขนาดตัวอักษรไม่ใช่ช่องทางเดียวในการอ่านค่า — พิมพ์ความถี่กำกับไว้ด้วย
  box.appendChild(U.h('p',{class:'hint',style:{'text-align':'center'},
    html:'<b>คำที่พบมากที่สุด:</b> '+words.slice(0,10).map(([w,c])=>`${U.esc(w)} (${c})`).join(' · ')}));
  return box;
}

/* ---------- 6.7 การ์ดความเห็น + จัดกลุ่มตามคำสำคัญ ---------- */
function notesView(q, t, room, o){
  o=o||{}; const host=!!o.host;
  const box = U.h('div',{class:'col'});
  const hidden = new Set(q.hiddenAnswers||[]);
  let items = (t.texts||[]);
  if(!host) items = items.filter(x=>!hidden.has(x.pid));
  if(!items.length){ box.appendChild(U.h('p',{class:'muted',style:{'text-align':'center',padding:'24px'},text:'ยังไม่มีความเห็นส่งเข้ามา'})); return box; }

  if(q.groupThemes){
    const freq = new Map();
    items.forEach(x=> new Set(segmentThai(x.text)).forEach(w=> freq.set(w,(freq.get(w)||0)+1)) );
    const keys = Array.from(freq.entries()).filter(([,c])=>c>=2).sort((a,b)=>b[1]-a[1]).slice(0,6).map(([w])=>w);
    const used = new Set(); const groups=[];
    keys.forEach(k=>{
      const mem = items.filter(x=>!used.has(x.pid) && segmentThai(x.text).includes(k));
      if(mem.length>=2){ mem.forEach(m=>used.add(m.pid)); groups.push({key:k, items:mem}); }
    });
    const rest = items.filter(x=>!used.has(x.pid));
    groups.forEach((g,gi)=>{
      const sec = U.h('div',{class:'theme-group'});
      sec.appendChild(U.h('h4',{},[ U.h('span',{style:{color:'var(--gold-ink)'},text:'“'+g.key+'” '}),
        document.createTextNode(`· ${g.items.length} ความเห็น`) ]));
      sec.appendChild(noteGrid(g.items, q, room, host, hidden, gi));
      box.appendChild(sec);
    });
    if(rest.length){
      const sec = U.h('div',{class:'theme-group'});
      sec.appendChild(U.h('h4',{text:`อื่น ๆ · ${rest.length} ความเห็น`}));
      sec.appendChild(noteGrid(rest, q, room, host, hidden, groups.length));
      box.appendChild(sec);
    }
  } else box.appendChild(noteGrid(items, q, room, host, hidden, 0));
  return box;
}
function noteGrid(items, q, room, host, hidden, seed){
  const g = U.h('div',{class:'notes'});
  items.forEach((x,i)=>{
    const named = room.display==='named' || (host && room.display==='hostOnly');
    const n = U.h('div',{class:'note'+(hidden.has(x.pid)?' hidden-note':''),style:{'--c':slotVar(seed*3+i)}});
