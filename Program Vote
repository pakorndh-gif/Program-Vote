      U.h('button',{class:'btn btn-sm',text:'🔍 แสดง QR ใหญ่',onclick:()=>dlgQR(room)}),
      U.h('button',{class:'btn btn-sm btn-ghost',text:'⬇ บันทึก QR',
        onclick:()=>{ try{ saveFile(`QR-ห้อง-${room.code}.svg`, QR.svg(link,900,4),'image/svg+xml'); }catch(e){ Toast.show('สร้างไฟล์ QR ไม่สำเร็จ'); } }})
    ]));
    info.appendChild(U.h('p',{class:'hint',text:'นักศึกษาสแกน QR หรือกดลิงก์จากมือถือเครื่องใดก็ได้ ไม่ต้องอยู่เครือข่ายเดียวกัน ไม่ต้องสมัครสมาชิก'}));
  } else {
    info.appendChild(U.h('p',{class:'hint',text:'ห้องนี้เก็บข้อมูลไว้ในเครื่องนี้ ผู้โหวตต้องเปิดอีกแท็บหรืออีกหน้าต่างบนเครื่องเดียวกัน — ถ้าต้องการให้สแกน QR จากมือถือ ให้สร้างห้องใหม่แบบ “ห้องเรียนออนไลน์”'}));
  }
  row.appendChild(info);
  c.appendChild(row);
  return c;
}
function dlgQR(room){
  const link = joinLink(room);
  const body = U.h('div',{class:'col',style:{'align-items':'center',gap:'14px'}});
