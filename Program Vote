    <p style="margin-top:10px">หากหน่วยงานต้องการเก็บข้อมูลไว้ในเครือข่ายของตนเอง สามารถเปลี่ยนเฉพาะส่วน <span class="mono">Online</span> ในโค้ดให้ชี้ไปที่เซิร์ฟเวอร์ภายในได้ โดยหน้าจอและกราฟทั้งหมดใช้ของเดิม</p>`));

  w.appendChild(sec('คีย์ลัดบนจอฉาย', `
    <p><span class="mono">←</span> / <span class="mono">→</span> เปลี่ยนคำถาม · <span class="mono">Spacebar</span> ซ่อน/เปิดผล · <span class="mono">F</span> เต็มจอ</p>`));

  root.appendChild(w);
  return root;
