  async saveMeta(){ if(!App.room) return; await Net.saveMeta(App.room); App.render(); },
  async refresh(){ if(!App.room) return; App.people = await Net.loadPeople(App.room); App.render(); },

  q(){ return (App.room&&App.room.questions||[]).find(x=>x.id===App.selQ) || null; },
  currentQ(){ const r=App.room; if(!r) return null; return (r.questions||[]).find(x=>x.id===r.currentQ) || null; },

  toggleTheme(){
    const next = document.documentElement.dataset.theme==='dark' ? 'light':'dark';
    document.documentElement.dataset.theme = next;
    document.body.dataset.palette = next==='light'
      ? '#2a78d6,#eb6834,#1baf7a,#eda100,#e87ba4,#008300,#6250d6,#e34948'
      : '#3987e5,#d95926,#199e70,#c98500,#d55181,#0ca30c,#9085e9,#e66767';
    LS.set(K.theme, next);
    App.render();
  },

  render(){
    const app = $('#app');
    clearChartListeners();          // ถอดตัวดักขนาดหน้าต่างของกราฟชุดเดิม ไม่ให้สะสม
    let view;
    try{
      if(App.route==='host')        view = viewHost();
      else if(App.route==='screen') view = viewScreen();
      else if(App.route==='vote')   view = viewVote();
      else if(App.route==='guide')  view = viewGuide();
      else                          view = viewStart();
    }catch(err){
      console.error(err);
      view = U.h('div',{class:'wrap wrap-narrow'},[
        U.h('div',{class:'card'},[
          U.h('h3',{text:'เกิดข้อผิดพลาดในการแสดงผล'}),
          U.h('p',{class:'hint',style:{'margin-top':'10px'},text:String(err&&err.message||err)}),
          U.h('button',{class:'btn btn-primary',style:{'margin-top':'16px'},text:'กลับหน้าแรก',onclick:()=>{ App.closeRoom(); App.nav('start'); }})
        ])
      ]);
    }
    app.innerHTML=''; app.appendChild(view);
  }
};

